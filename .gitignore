# Variaveis de ambiente (contem segredos) — NUNCA versionar.
# O .env.example (sem segredos) fica de fora da regra e e versionado.
.env
.env.*
!.env.example

# Chaves VAPID do Web Push (contem a chave PRIVADA) — NUNCA versionar.
vapid.json
vapid-keys.txt
vapid-public.txt

# Backups baixados pelo app (§17). O navegador salva onde estiver apontado, e
# um deles ja caiu aqui na raiz durante os testes — sao DADOS REAIS: CPF,
# dados bancarios das fichas (§19) e o celular da equipe. Nunca versionar.
service-desk-backup-*.zip
service-desk-anexos-*.zip

# Rastros locais do CLI do Supabase: qual projeto esta "linkado" nesta maquina
# (supabase/.temp) e o lock do Deno gerado ao deployar uma Edge Function. Sao
# estado da MAQUINA, nao do projeto — versionar so criaria conflito entre
# maquinas diferentes.
supabase/.temp/
deno.lock
